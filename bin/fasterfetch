}

# ------------------------------------------------------------------------ ---

usage() {
	cat <<'EOF'
Usage: fasterfetch [options] [-- extra chafa args...]

Options:
  -w, --width COLS     image width in terminal cells (default: whatever is
                       left over after the info block)
  -H, --height ROWS    image height in cells (default: the number of lines
                       fastfetch printed)
  -g, --gap COLS       blank columns between image and info (default: 2)
  -v, --valign POS     vertical placement of the image relative to the info
                       block: top, center, bottom (default: top)
      --ff-arg ARG     extra argument passed to fastfetch (repeatable)
  -V, --verbose        print what the terminal, chafa and the layout maths
                       report, then exit without drawing anything
  -h, --help           this text

The image is embedded in this script; there is nothing to pass on the command
line.  The renderer is chosen automatically: text symbols everywhere, upgraded
to kitty graphics when the terminal says it supports them.  Set the environment
variable FFCHAFA_RENDER to "symbols" or "kitty" to pin it by hand, and
FFCHAFA_PROBE_TIMEOUT to change how long the support query waits (default 1s).

Anything after `--` is handed to chafa verbatim, e.g.

  fasterfetch -- --dither none --symbols block
EOF
}

image=
width=
height=
gap=2
valign=top
verbose=
ff_args=()
chafa_args=()

while (($#)); do
	case $1 in
	-w | --width) width=${2:?--width needs a value}; shift 2 ;;
	-H | --height) height=${2:?--height needs a value}; shift 2 ;;
	-g | --gap) gap=${2:?--gap needs a value}; shift 2 ;;
	-v | --valign) valign=${2:?--valign needs a value}; shift 2 ;;
	-V | --verbose) verbose=1; shift ;;
	--ff-arg) ff_args+=("${2:?--ff-arg needs a value}"); shift 2 ;;
	-h | --help) usage; exit 0 ;;
	--) shift; chafa_args=("$@"); break ;;
	-*) die "unknown option: $1" ;;
	*) die "unexpected argument '$1' (the image is built in; chafa options go after --)" ;;
	esac
done

command -v fastfetch >/dev/null || die "fastfetch not found in PATH"
command -v chafa >/dev/null || die "chafa not found in PATH"
command -v base64 >/dev/null || die "base64 not found in PATH"

case $valign in top | center | bottom) ;; *) die "bad --valign: $valign" ;; esac
[[ $gap =~ ^[0-9]+$ ]] || die "--gap must be a non-negative integer"
[[ -z $width || $width =~ ^[0-9]+$ ]] || die "--width must be a positive integer"
[[ -z $height || $height =~ ^[0-9]+$ ]] || die "--height must be a positive integer"

# ---------------------------------------------------------------- helpers ---

esc=$'\033'
csi_re="$esc\\[[0-9;?]*[a-zA-Z]"

# Everything here counts terminal cells, and chafa's block symbols are
# multibyte UTF-8.  Bash's ${#var} counts characters rather than bytes only
# under a UTF-8 locale, so make sure we're in one.  (Counting bytes silently
# inflates every width by ~3x and shoves the info block off to the right.)
if [[ $(locale charmap 2>/dev/null) != *UTF-8* ]]; then
	while read -r loc; do
		case $loc in
		C.UTF-8 | C.utf8 | *.UTF-8 | *.utf8) export LC_ALL=$loc; break ;;
		esac
	done < <(locale -a 2>/dev/null)
fi

# Display width, in cells, of each line on stdin -- one number per line, ANSI
# sequences discarded.  Deliberately *not* awk: Ubuntu and friends ship mawk,
# whose length() is byte-based no matter what the locale says.
line_widths() {
	local plain
	while IFS= read -r plain; do printf '%s\n' "${#plain}"; done < <(sed "s/$csi_re//g")
}

repeat_space() { printf '%*s' "$1" ''; }

# One round trip that asks the terminal everything we care about:
#   * kitty's documented graphics-support handshake (query a 1x1 RGB image)
#   * CSI 16t -- cell size in pixels
#   * CSI 14t / CSI 18t -- text area in pixels / in cells, to derive cell size
#     when 16t goes unanswered
#   * CSI c  -- primary device attributes, answered by everything, which is
#     what stops us waiting forever on terminals that ignore the rest
# These travel in band, so they survive ssh and pty wrappers that drop the
# pixel fields of the winsize ioctl (which is where chafa gets its geometry).
probe_raw=
probe_kitty=
cell_w=
cell_h=
area_px=
area_cells=

probe_terminal() {
	local saved
	probe_raw=
	[[ -t 1 && -e /dev/tty ]] || return 1

	saved=$(stty -g </dev/tty 2>/dev/null) || return 1
	stty raw -echo </dev/tty
	printf '%s_Gi=31,s=1,v=1,a=q,t=d,f=24;AAAA%s\\%s[16t%s[14t%s[18t%s[c' \
		"$esc" "$esc" "$esc" "$esc" "$esc" "$esc" >/dev/tty
	IFS= read -rd c -t "${FFCHAFA_PROBE_TIMEOUT:-1}" probe_raw </dev/tty || true
	stty "$saved" </dev/tty

	[[ $probe_raw == *"_Gi=31;OK"* ]] && probe_kitty=1
	[[ $probe_raw =~ \[6\;([0-9]+)\;([0-9]+)t ]] &&
		{ cell_h=${BASH_REMATCH[1]}; cell_w=${BASH_REMATCH[2]}; }
	[[ $probe_raw =~ \[4\;([0-9]+)\;([0-9]+)t ]] &&
		area_px="${BASH_REMATCH[2]}x${BASH_REMATCH[1]}"
	[[ $probe_raw =~ \[8\;([0-9]+)\;([0-9]+)t ]] &&
		area_cells="${BASH_REMATCH[2]}x${BASH_REMATCH[1]}"
	return 0
}

supports_kitty() {
	# Multiplexers need protocol passthrough that the query itself can't rely
	# on, so stay on symbols rather than risk drawing garbage into the pane.
	[[ -n ${TMUX-} || $TERM == screen* || $TERM == tmux* ]] && return 1
	[[ -n $probe_kitty ]]
}

# Render the terminal's raw answer readably, ^[ style.
show_raw() { printf '%s' "${1-}" | cat -v; }

# chafa learns the terminal's cell geometry from the winsize ioctl's pixel
# fields.  ssh and pty wrappers routinely drop those, and chafa before 1.16 has
# no in-band probe to fall back on -- it then assumes square 8x8 cells and
# resizes the bitmap to the wrong aspect before the terminal ever sees it.
# Our own probe already learned the truth, so write it into the ioctl for the
# duration of the run.  Same rows and columns, pixel fields only.
read_winsize() {
	{
		python3 -c 'import fcntl,termios,struct,sys
print(*struct.unpack("HHHH",fcntl.ioctl(sys.stdin.fileno(),termios.TIOCGWINSZ,b"\0"*8)))' </dev/tty ||
			perl -e 'my $w = ""; ioctl(STDIN, 0x5413, $w) or exit 1;
print join(" ", unpack("S4", $w)), "\n"' </dev/tty
	} 2>/dev/null
}

write_winsize() { # rows cols xpixel ypixel
	{
		python3 -c 'import fcntl,termios,struct,sys
fcntl.ioctl(sys.stdin.fileno(),termios.TIOCSWINSZ,struct.pack("HHHH",*map(int,sys.argv[1:5])))' \
			"$@" </dev/tty ||
			perl -e 'ioctl(STDIN, 0x5414, pack("S4", @ARGV[0 .. 3])) or exit 1' "$@" </dev/tty
	} 2>/dev/null
}

winsize_saved=
winsize_before=
winsize_note="not needed"
restore_winsize() {
	[[ -n $winsize_saved ]] || return 0
	# shellcheck disable=SC2086
	write_winsize $winsize_saved || true
	winsize_saved=
}

lend_winsize_geometry() {
	local ws rows cols xp yp
	# chafa 1.16 gained --probe and asks the terminal directly, so it finds the
	# geometry with or without the ioctl.  Don't touch the tty for those.
	if [[ $chafa_help == *--probe* ]]; then
		winsize_note="not needed (chafa probes the terminal itself)"
		return 0
	fi
	[[ -n $cell_w && -n $cell_h && -e /dev/tty ]] || return 0

	ws=$(read_winsize) || { winsize_note="unreadable (no python3 or perl)"; return 0; }
	winsize_before=$ws
	read -r rows cols xp yp <<<"$ws" || return 0
	[[ $rows =~ ^[0-9]+$ && $cols =~ ^[0-9]+$ ]] || return 0
	if ((xp > 0 && yp > 0)); then
		winsize_note="already present (${xp}x${yp} px)"
		return 0
	fi

	if write_winsize "$rows" "$cols" "$((cols * cell_w))" "$((rows * cell_h))"; then
		winsize_saved="$rows $cols $xp $yp"
		winsize_note="patched to $((cols * cell_w))x$((rows * cell_h)) px from CSI 16t"
	else
		winsize_note="write failed (no python3 or perl)"
	fi
}

# --------------------------------------------------------- unpack the art ---

# chafa wants a file, so spill the payload into a scratch dir for the run.
# Everything below can exit, so the cleanup trap covers the winsize ioctl too.
workdir=$(mktemp -d "${TMPDIR:-/tmp}/fasterfetch.XXXXXX") ||
	die "cannot create a temporary directory"
cleanup() { restore_winsize; rm -rf -- "$workdir"; }
trap cleanup EXIT INT TERM

image=$workdir/logo.webp
embedded_image_b64 >"$workdir/logo.b64"
# GNU coreutils spells it --decode; BSD/macOS wants -D.
base64 --decode "$workdir/logo.b64" >"$image" 2>/dev/null ||
	base64 -D -i "$workdir/logo.b64" -o "$image" 2>/dev/null ||
	die "could not decode the embedded image"
[[ -s $image ]] || die "the embedded image decoded to nothing"

# ------------------------------------------------------------- fastfetch ---

# --logo none drops the built-in ASCII art; --pipe false keeps the colour
# escapes alive even though we're capturing into a variable.
ff_out=$(fastfetch --logo none --pipe false "${ff_args[@]}") ||
	die "fastfetch failed"

mapfile -t info < <(printf '%s\n' "$ff_out")
# Trim trailing blank lines so the image doesn't get padded against nothing.
while ((${#info[@]})) && [[ -z ${info[-1]//[[:space:]]/} ]]; do
	unset 'info[-1]'
done
info_rows=${#info[@]}

info_cols=0
if ((info_rows)); then
	while read -r w; do ((w > info_cols)) && info_cols=$w; done < <(
		printf '%s\n' "${info[@]}" | line_widths
	)
fi

# ------------------------------------------------------------------ sizes ---

term_cols=$( { tput cols; } 2>/dev/null || true)
[[ $term_cols =~ ^[0-9]+$ ]] || term_cols=${COLUMNS:-80}

if [[ -z $width ]]; then
	width=$((term_cols - info_cols - gap))
fi
[[ -z $height ]] && height=$info_rows
((height < 1)) && height=20

# Not enough room to put anything meaningful beside the text: bail out to a
# plain fastfetch rather than emitting a mangled two-column layout.
if ((width < 8)); then
	printf '%s\n' "${info[@]}"
	exit 0
fi

# chafa gained --exact-size somewhere along the way; without it a terminal
# that reports its cell geometry can decide to draw the image at native pixel
# size and blow straight past the box we budgeted for it.
# Capture the help text rather than piping into grep: an early-exiting reader
# hands chafa a SIGPIPE, and under `set -o pipefail` that reads as failure.
chafa_help=$(chafa --help 2>&1) || chafa_help=
size_args=(--size "${width}x${height}" --animate off)
[[ $chafa_help == *--exact-size* ]] && size_args+=(--exact-size off)

render=${FFCHAFA_RENDER:-auto}
case $render in symbols | kitty | auto) ;;
*) die "bad FFCHAFA_RENDER: $render (want symbols, kitty or auto)" ;;
esac

[[ $render == auto || -n $verbose ]] && { probe_terminal || true; }
if [[ $render == auto ]]; then
	render=symbols
	supports_kitty && render=kitty
fi
[[ $render == kitty && ! -t 1 ]] && render=symbols

# Do this before any chafa run, and for symbols too -- chafa uses the same
# geometry to decide how wide a cell is when fitting the image.
lend_winsize_geometry

# ------------------------------------------------------------ diagnostics ---

if [[ -n $verbose ]]; then
	# -t 1 has to be sampled out here; inside $( ) stdout is the substitution
	# pipe, so it would always claim "not a tty".
	if [[ -t 1 ]]; then stdout_tty=yes; else stdout_tty=no; fi
	if [[ -n $probe_kitty ]]; then kitty_says=yes; else kitty_says=no; fi

	# No `| head` anywhere below -- truncating a reader kills chafa with
	# SIGPIPE, which pipefail turns into a fatal error.  Slice in bash instead.
	kitty_apc=
	blob_head=$(chafa --format kitty "${size_args[@]}" "${chafa_args[@]}" -- "$image" 2>/dev/null) ||
		blob_head=
	[[ ${blob_head:0:4096} =~ ${esc}_G([^;]*)\; ]] && kitty_apc=${BASH_REMATCH[1]}
	blob_head=

	sym=$(chafa --format symbols "${size_args[@]}" "${chafa_args[@]}" -- "$image" 2>/dev/null |
		sed "s/$esc\\[?25[lh]//g") || sym=
	sym_rows=0 sym_cols=0
	while read -r w; do
		((w)) || continue
		((++sym_rows))
		((w > sym_cols)) && sym_cols=$w
	done < <(printf '%s\n' "$sym" | line_widths)

	# The pixel fields are the ones that matter: chafa reads its cell geometry
	# from here.  Report what was there before we lent it ours.
	winsize=$winsize_before
	[[ -n $winsize ]] || winsize=$(read_winsize) || winsize=
	if [[ $winsize =~ ^([0-9]+)\ ([0-9]+)\ ([0-9]+)\ ([0-9]+)$ ]]; then
		winsize="rows=${BASH_REMATCH[1]} cols=${BASH_REMATCH[2]}"
		winsize+=" xpixel=${BASH_REMATCH[3]} ypixel=${BASH_REMATCH[4]}"
	else
		winsize="unavailable (needs python3 or perl on a tty)"
	fi

	{
		echo "== fasterfetch diagnostics =="
		echo "script        : $0"
		echo "bash          : $BASH_VERSION"
		echo "locale        : LC_ALL=${LC_ALL-} LANG=${LANG-} charmap=$(locale charmap 2>/dev/null)"
		echo "env           : TERM=${TERM-} COLORTERM=${COLORTERM-} TMUX=${TMUX-} SSH_TTY=${SSH_TTY-}"
		echo "chafa         : $(chafa --version 2>&1 | sed -n 1p)"
		echo "fastfetch     : $(fastfetch --version 2>&1 | sed -n 1p)"
		echo "stdout is tty : $stdout_tty"
		echo "embedded art  : $(wc -c <"$image") bytes -> $image"
		echo "winsize ioctl : $winsize"
		echo "winsize patch : $winsize_note"
		echo "tput cols     : $term_cols"
		echo "probe reply   : $(show_raw "$probe_raw")"
		echo "  kitty       : $kitty_says"
		echo "  cell size   : ${cell_w:-?}x${cell_h:-?} px (CSI 16t)"
		echo "  text area   : ${area_px:-?} px (CSI 14t) / ${area_cells:-?} cells (CSI 18t)"
		echo "info block    : ${info_rows} rows x ${info_cols} cols"
		echo "layout box    : width=$width height=$height gap=$gap valign=$valign"
		echo "renderer      : $render"
		echo "chafa symbols : ${sym_cols}x${sym_rows} cells"
		echo "chafa kitty   : ${kitty_apc:-<no APC emitted>}"
		echo "chafa args    : ${size_args[*]} ${chafa_args[*]-}"
	}
	exit 0
fi

# ---------------------------------------------------------------- compose ---

if [[ $render == kitty ]]; then
	# One chafa run, and it tells us exactly how much room it takes: the kitty
	# APC header carries c=<cols>,r=<rows>.  Taking the footprint from chafa's
	# own output rather than measuring a symbols render keeps the text column
	# glued to the image no matter what the terminal reports about its cells --
	# the two renderers do *not* always pick the same fit.
	blob=$(chafa --format kitty "${size_args[@]}" "${chafa_args[@]}" -- "$image") ||
		die "chafa failed on the embedded image"

	if [[ ${blob:0:2048} =~ c=([0-9]+),r=([0-9]+) ]]; then
		img_cols=${BASH_REMATCH[1]}
		img_rows=${BASH_REMATCH[2]}
	else
		# No declared placement (older chafa): fall back to symbols, which we
		# can measure directly, rather than guess at the geometry.
		render=symbols
	fi
fi

if [[ $render == symbols ]]; then
	symbols_out=$(chafa --format symbols "${size_args[@]}" "${chafa_args[@]}" -- "$image") ||
		die "chafa failed on the embedded image"

	mapfile -t img < <(printf '%s\n' "$symbols_out" | sed "s/$esc\\[?25[lh]//g")
	while ((${#img[@]})) && [[ -z ${img[-1]//[[:space:]]/} ]]; do
		unset 'img[-1]'
	done
	img_rows=${#img[@]}
	((img_rows)) || die "chafa produced no output for the embedded image"

	mapfile -t img_w < <(printf '%s\n' "${img[@]}" | line_widths)
	img_cols=0
	for w in "${img_w[@]}"; do ((w > img_cols)) && img_cols=$w; done
fi

# Where the image starts, vertically, relative to the info block.
pad_top=0
if ((img_rows < info_rows)); then
	case $valign in
	center) pad_top=$(((info_rows - img_rows) / 2)) ;;
	bottom) pad_top=$((info_rows - img_rows)) ;;
	esac
fi

total_rows=$((img_rows + pad_top))
((info_rows > total_rows)) && total_rows=$info_rows
text_col=$((img_cols + gap + 1)) # 1-based column for the info block

if [[ $render == symbols ]]; then
	# Text art composites line by line: pad each image row out to the full
	# image width, reset colours, then append the matching info row.
	blank=$(repeat_space "$((img_cols + gap))")
	for ((row = 0; row < total_rows; row++)); do
		i=$((row - pad_top))
		if ((i >= 0 && i < img_rows)); then
			printf '%s%s%s' "${img[i]}" "$esc[0m" \
				"$(repeat_space "$((img_cols - img_w[i] + gap))")"
		else
			printf '%s' "$blank"
		fi
		((row < info_rows)) && printf '%s' "${info[row]}"
		printf '%s\n' "$esc[0m"
	done
	exit 0
fi

# Kitty graphics arrive as one opaque blob that can't be sliced per line, so
# place it with cursor movement instead: reserve the rows, draw the image,
# jump back, then write each info line at a fixed column.
printf '\n%.0s' $(seq "$total_rows")  # scroll room for the whole block
printf '%s[%dA' "$esc" "$total_rows" # back to the top of it

printf '%s7' "$esc" # save the block's origin
((pad_top)) && printf '%s[%dB' "$esc" "$pad_top"
printf '%s' "$blob"
printf '%s8' "$esc" # and return to it

for ((row = 0; row < total_rows; row++)); do
	((row < info_rows)) && printf '%s[%dG%s%s[0m' "$esc" "$text_col" "${info[row]}" "$esc"
	((row < total_rows - 1)) && printf '%s[1B' "$esc" # down without scrolling
done
printf '%s[1G\n' "$esc"
