#!/usr/bin/env bash
#
# fasterfetch -- render the embedded image next to fastfetch's info block.
#
# fastfetch refuses image logos in a bunch of situations (pipe mode, terminals
# it doesn't recognise, formats its imagemagick delegate won't load).  This
# sidesteps that: fastfetch runs with no logo at all, chafa renders the image
# on its own, and the two get pasted together here.
#
# The image ships inside this file as base64 -- no arguments, no data files,
# just run it.
#
# Text symbols are the default renderer.  If the terminal answers kitty's
# graphics-support query, it gets upgraded to the kitty protocol instead.
#
# Usage:  fasterfetch [options] [-- extra chafa args...]

set -euo pipefail

die() { printf '%s: %s\n' "${0##*/}" "$*" >&2; exit 1; }

# --------------------------------------------------------------- payload ---
# The logo, base64'd.  Generated -- edit the image, not this block.

embedded_image_b64() {
