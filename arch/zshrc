#!/bin/zsh
# Unlike the headless profile, no PATH change is needed here: fortune and
# cowsay live in /usr/bin on Arch, already on the inherited PATH before this
# file runs. The greeting still has to run before the instant-prompt block
# below: p10k's instant prompt treats any console output produced from here
# on as suspect, right up until the real first prompt is drawn, so printing
# before it starts monitoring avoids the warning entirely.
source "$HOME/dotfiles/shared/zsh/functions.zsh"
give_fortune

# Powerlevel10k instant prompt. Keep near the top, and after the greeting
# above -- see the comment there.
if [[ -r "${XDG_CACHE_HOME:-$HOME/.cache}/p10k-instant-prompt-${(%):-%n}.zsh" ]]; then
  source "${XDG_CACHE_HOME:-$HOME/.cache}/p10k-instant-prompt-${(%):-%n}.zsh"
fi
ZSH_THEME="powerlevel10k/powerlevel10k"

plugins=(git archlinux colorize common-aliases zsh-interactive-cd)
export ZSH="$HOME/.oh-my-zsh"
source $ZSH/oh-my-zsh.sh

source /usr/share/zsh/plugins/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh
source /usr/share/zsh/plugins/zsh-autosuggestions/zsh-autosuggestions.zsh
source /usr/share/zsh-theme-powerlevel10k/powerlevel10k.zsh-theme

fpath=(~/.local/share/zsh/site-functions $fpath)
zstyle :compinstall filename "$HOME/.zshrc"
autoload -Uz compinit
compinit
autoload -Uz add-zsh-hook

source "$HOME/dotfiles/shared/zsh/options.zsh"

# Pick up newly installed pacman binaries without a manual rehash.
rehash_precmd() {
  if [[ -a /var/cache/zsh/pacman ]]; then
    local paccache_time="$(date -r /var/cache/zsh/pacman +%s%N)"
    if (( zshcache_time < paccache_time )); then
      rehash
      zshcache_time="$paccache_time"
    fi
  fi
}
add-zsh-hook -Uz precmd rehash_precmd

ZSH_COLORIZE_STYLE="colorful"
ZSH_AUTOSUGGEST_HIGHLIGHT_STYLE='fg=23'
[[ "$(cat /proc/$PPID/comm)" =~ "kitty" ]] && alias ssh="kitten ssh"
export EDITOR=nvim
export PATH=$HOME/bin:$HOME/.local/bin:/usr/local/bin:$PATH:$HOME/Android/Sdk/platform-tools:$HOME/Android/Sdk/emulator
export ANDROID_HOME="$HOME/Android/Sdk"
export NODE_OPTIONS="--max_old_space_size=8196 --stack-trace-limit=1000"

[[ ! -f ~/.p10k.zsh ]] || source ~/.p10k.zsh

alias new_mirrorlist="reflector -n 50 -c US --delay 0.25 -f 20 --sort rate > mirrorlist.new"

monitor_app() {
  adb logcat --pid=$(adb shell pidof com.voiceerp.voiceerp)
}

# The clipboard portal is no longer built here. Two pieces own it now, and
# neither is per-workspace: herdr-clipboard.socket answers on
# 127.0.0.1:52052 for the whole graphical session, and the `Host *.coder`
# stanza in ~/.ssh/config.d/herdr-clipboard.conf puts the reverse forward on
# whichever connection reaches the workspace first -- this function's, or
# herdr-mirror's daemon. A new workspace therefore needs no setup, and this
# function shrank from ~150 lines to this: the socat responder, its readiness
# log-scrape, the private ssh master, and three process groups' worth of
# teardown all moved into systemd and ssh_config.
#
# What is left is worth keeping. The local responder is still checked before
# herdr starts, because the alternative is a session that looks fine until
# the first "+p silently returns nothing. The remote end is deliberately not
# probed: the forward may legitimately be held by herdr-mirror rather than by
# us, and there is no cheap way to tell "someone else already bound it"
# (fine) from "nothing is listening" (broken) without a round trip.
herdr_remote() {
  setopt localoptions
  setopt localtraps
  trap 'return 130' INT
  local host=${1:-richard-worktree-2.coder}
  local original_kitty_colors

  # `start` on a socket unit returns once it is listening, so is-active
  # immediately after is not a race. It is also idempotent, which is what
  # lets this work whether or not the unit was enabled for the session.
  if ! systemctl --user start herdr-clipboard.socket 2>/dev/null ||
      ! systemctl --user --quiet is-active herdr-clipboard.socket; then
    print -u2 'herdr_remote: clipboard responder is not listening on 127.0.0.1:52052'
    print -u2 'herdr_remote: systemctl --user enable --now herdr-clipboard.socket'
    return 1
  fi

  original_kitty_colors=$(kitty @ get-colors) || return
  {
    kitty @ set-colors '~/.config/kitty/kitty-themes/Catppuccin-Mocha.conf'
    herdr --remote "$host"
  } always {
    kitty @ set-colors <(print -r -- "$original_kitty_colors")
  }
}

. /usr/share/nvm/init-nvm.sh

[[ ! -f ~/.zshrc.local ]] || source ~/.zshrc.local
