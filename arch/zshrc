#!/bin/zsh
# Unlike the headless profile, no PATH change is needed here: fortune and
# cowsay live in /usr/bin on Arch, already on the inherited PATH before this
# file runs. The greeting still has to run before the instant-prompt block
# below: p10k's instant prompt treats any console output produced from here
# on as suspect, right up until the real first prompt is drawn, so printing
# before it starts monitoring avoids the warning entirely.
source "$HOME/dotfiles/shared/zsh/functions.zsh"
give_fortune

# Powerlevel10k instant prompt. Keep near the top, and after the greeting
# above -- see the comment there.
if [[ -r "${XDG_CACHE_HOME:-$HOME/.cache}/p10k-instant-prompt-${(%):-%n}.zsh" ]]; then
  source "${XDG_CACHE_HOME:-$HOME/.cache}/p10k-instant-prompt-${(%):-%n}.zsh"
fi
ZSH_THEME="powerlevel10k/powerlevel10k"

plugins=(git archlinux colorize common-aliases zsh-interactive-cd)
export ZSH="$HOME/.oh-my-zsh"
source $ZSH/oh-my-zsh.sh

source /usr/share/zsh/plugins/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh
source /usr/share/zsh/plugins/zsh-autosuggestions/zsh-autosuggestions.zsh
source /usr/share/zsh-theme-powerlevel10k/powerlevel10k.zsh-theme

fpath=(~/.local/share/zsh/site-functions $fpath)
zstyle :compinstall filename "$HOME/.zshrc"
autoload -Uz compinit
compinit
autoload -Uz add-zsh-hook

source "$HOME/dotfiles/shared/zsh/options.zsh"

# Pick up newly installed pacman binaries without a manual rehash.
rehash_precmd() {
  if [[ -a /var/cache/zsh/pacman ]]; then
    local paccache_time="$(date -r /var/cache/zsh/pacman +%s%N)"
    if (( zshcache_time < paccache_time )); then
      rehash
      zshcache_time="$paccache_time"
    fi
  fi
}
add-zsh-hook -Uz precmd rehash_precmd

ZSH_COLORIZE_STYLE="colorful"
ZSH_AUTOSUGGEST_HIGHLIGHT_STYLE='fg=23'
[[ "$(cat /proc/$PPID/comm)" =~ "kitty" ]] && alias ssh="kitten ssh"
export EDITOR=nvim
export PATH=$HOME/bin:$HOME/.local/bin:/usr/local/bin:$PATH:$HOME/Android/Sdk/platform-tools:$HOME/Android/Sdk/emulator
export ANDROID_HOME="$HOME/Android/Sdk"
export NODE_OPTIONS="--max_old_space_size=8196 --stack-trace-limit=1000"

[[ ! -f ~/.p10k.zsh ]] || source ~/.p10k.zsh

alias new_mirrorlist="reflector -n 50 -c US --delay 0.25 -f 20 --sort rate > mirrorlist.new"

monitor_app() {
  adb logcat --pid=$(adb shell pidof com.voiceerp.voiceerp)
}

gpt_code() {
  local original_kitty_colors
  original_kitty_colors=$(kitty @ get-colors) || return
  {
    kitty @ set-colors  "~/.config/kitty/kitty-themes/Catppuccin-Mocha.conf"
    kitty @ set-tab-title "GPT Code"
     env \
      CLAUDE_CONFIG_DIR="$HOME/.config/claude-other/" \
      ANTHROPIC_BASE_URL="http://127.0.0.1:8317" \
      ENABLE_CLAUDEAI_MCP_SERVERS=false \
      DISABLE_TELEMETRY=1 \
      CLAUDE_CODE_DISABLE_NONESSENTIAL_TRAFFIC=1 \
      ANTHROPIC_AUTH_TOKEN="${ANTHROPIC_AUTH_TOKEN:-}" \
      ANTHROPIC_DEFAULT_OPUS_MODEL="gpt-5.6-sol" \
      ANTHROPIC_DEFAULT_SONNET_MODEL="gpt-5.6-terra" \
      ANTHROPIC_DEFAULT_HAIKU_MODEL="gpt-5.6-luna" \
      claude --model gpt-5.6-sol
  } always {
    kitty @ set-colors <(print -r -- "$original_kitty_colors")
    kitty @ set-tab-title ""
  }
}

herdr_remote() {
  setopt localoptions
  setopt localtraps
  trap 'return 130' INT
  local original_kitty_colors clipboard_server_log='' clipboard_server_pid='' clipboard_server_pgid=''
  local clipboard_server_observed_pgid clipboard_server_ready=false clipboard_server_monitor=false
  local clipboard_ssh_dir='' clipboard_ssh_socket='' clipboard_ssh_pid='' clipboard_ssh_pgid=''
  local clipboard_ssh_observed_pgid clipboard_ssh_ready=false
  [[ -o monitor ]] && clipboard_server_monitor=true
  setopt nomonitor
  original_kitty_colors=$(kitty @ get-colors) || return
  {
    if ! clipboard_server_log=$(mktemp "${TMPDIR:-/tmp}/herdr_remote.XXXXXXXX" 2>/dev/null); then
      print -u2 'herdr_remote: could not bind clipboard responder to 127.0.0.1:52052'
      return 1
    fi

    setsid socat -d -d -lf "$clipboard_server_log" \
      TCP4-LISTEN:52052,bind=127.0.0.1,reuseaddr,fork \
      SYSTEM:'wl-paste --no-newline 2>/dev/null' >/dev/null 2>&1 &
    clipboard_server_pid=$!
    clipboard_server_pgid=$clipboard_server_pid
    if [[ "$clipboard_server_monitor" == true ]]; then
      setopt monitor
    fi
    clipboard_server_observed_pgid=$(ps -o pgid= -p "$clipboard_server_pid" 2>/dev/null)
    clipboard_server_observed_pgid=${clipboard_server_observed_pgid//[[:space:]]/}

    for _ in {1..20}; do
      if ! kill -0 "$clipboard_server_pid" 2>/dev/null; then
        break
      fi
      sleep 0.05
      if ! kill -0 "$clipboard_server_pid" 2>/dev/null; then
        break
      fi

      clipboard_server_observed_pgid=$(ps -o pgid= -p "$clipboard_server_pid" 2>/dev/null)
      clipboard_server_observed_pgid=${clipboard_server_observed_pgid//[[:space:]]/}

      if [[ "$clipboard_server_observed_pgid" == "$clipboard_server_pid" &&
            "$(<"$clipboard_server_log")" == *"socat[$clipboard_server_pid] N listening on AF=2 127.0.0.1:52052"* ]]; then
        clipboard_server_ready=true
        break
      fi
    done

    if [[ "$clipboard_server_ready" != true ]]; then
      if [[ -n "$clipboard_server_pgid" ]] &&
          kill -0 -- "-$clipboard_server_pgid" 2>/dev/null; then
        kill -TERM -- "-$clipboard_server_pgid" 2>/dev/null
      elif kill -0 "$clipboard_server_pid" 2>/dev/null; then
        kill "$clipboard_server_pid" 2>/dev/null
      fi
      wait "$clipboard_server_pid" 2>/dev/null
      rm -f -- "$clipboard_server_log"
      clipboard_server_log=''
      clipboard_server_pid=''
      clipboard_server_pgid=''
      print -u2 'herdr_remote: could not bind clipboard responder to 127.0.0.1:52052'
      return 1
    fi

    if ! clipboard_ssh_dir=$(mktemp -d "${TMPDIR:-/tmp}/herdr_remote.ssh.XXXXXXXX" 2>/dev/null); then
      print -u2 'herdr_remote: could not establish clipboard SSH tunnel'
      return 1
    fi
    clipboard_ssh_socket="$clipboard_ssh_dir/control"

    setopt nomonitor
    setsid ssh -M -S "$clipboard_ssh_socket" -N -T -n \
      -o ControlPersist=no \
      -o ExitOnForwardFailure=yes \
      -o ClearAllForwardings=yes \
      richard-worktree-2.coder >/dev/null 2>&1 &
    clipboard_ssh_pid=$!
    clipboard_ssh_pgid=$clipboard_ssh_pid
    if [[ "$clipboard_server_monitor" == true ]]; then
      setopt monitor
    fi

    for _ in {1..240}; do
      if ! kill -0 "$clipboard_ssh_pid" 2>/dev/null; then
        break
      fi
      sleep 0.25
      if ! kill -0 "$clipboard_ssh_pid" 2>/dev/null; then
        break
      fi
      clipboard_ssh_observed_pgid=$(ps -o pgid= -p "$clipboard_ssh_pid" 2>/dev/null)
      clipboard_ssh_observed_pgid=${clipboard_ssh_observed_pgid//[[:space:]]/}
      if [[ "$clipboard_ssh_observed_pgid" == "$clipboard_ssh_pid" &&
            -S "$clipboard_ssh_socket" ]] &&
          ssh -S "$clipboard_ssh_socket" -O check richard-worktree-2.coder >/dev/null 2>&1; then
        clipboard_ssh_ready=true
        break
      fi
    done

    if [[ "$clipboard_ssh_ready" != true ]]; then
      print -u2 'herdr_remote: could not establish clipboard SSH tunnel'
      return 1
    fi

    if ! ssh -S "$clipboard_ssh_socket" -O forward \
        -R 127.0.0.1:52052:127.0.0.1:52052 \
        richard-worktree-2.coder >/dev/null 2>&1; then
      print -u2 'herdr_remote: could not establish clipboard SSH tunnel'
      return 1
    fi

    kitty @ set-colors '~/.config/kitty/kitty-themes/Catppuccin-Mocha.conf'
    herdr --remote richard-worktree-2.coder
  } always {
    if [[ -n "$clipboard_ssh_socket" && -S "$clipboard_ssh_socket" ]]; then
      ssh -S "$clipboard_ssh_socket" -O exit richard-worktree-2.coder >/dev/null 2>&1
    fi
    if [[ -n "$clipboard_ssh_pgid" ]] &&
        kill -0 -- "-$clipboard_ssh_pgid" 2>/dev/null; then
      kill -TERM -- "-$clipboard_ssh_pgid" 2>/dev/null
    elif [[ -n "$clipboard_ssh_pid" ]] &&
        kill -0 "$clipboard_ssh_pid" 2>/dev/null; then
      kill "$clipboard_ssh_pid" 2>/dev/null
    fi
    if [[ -n "$clipboard_ssh_pid" ]]; then
      wait "$clipboard_ssh_pid" 2>/dev/null
    fi
    if [[ -n "$clipboard_ssh_dir" && -n "$clipboard_ssh_socket" &&
          "$clipboard_ssh_socket" == "$clipboard_ssh_dir/control" ]]; then
      rm -f -- "$clipboard_ssh_socket" "$clipboard_ssh_socket".*(N)
    fi
    if [[ -n "$clipboard_ssh_dir" ]]; then
      rmdir -- "$clipboard_ssh_dir" 2>/dev/null
    fi

    if [[ -n "$clipboard_server_pgid" ]] &&
        kill -0 -- "-$clipboard_server_pgid" 2>/dev/null; then
      kill -TERM -- "-$clipboard_server_pgid" 2>/dev/null
    elif [[ -n "$clipboard_server_pid" ]] &&
        kill -0 "$clipboard_server_pid" 2>/dev/null; then
      kill "$clipboard_server_pid" 2>/dev/null
    fi
    if [[ -n "$clipboard_server_pid" ]]; then
      wait "$clipboard_server_pid" 2>/dev/null
    fi
    if [[ -n "$clipboard_server_log" ]]; then
      rm -f -- "$clipboard_server_log"
    fi
    kitty @ set-colors <(print -r -- "$original_kitty_colors")
  }
}

. /usr/share/nvm/init-nvm.sh

[[ ! -f ~/.zshrc.local ]] || source ~/.zshrc.local
